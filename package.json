{
  "name": "object-vcs-monorepo",
  "version": "0.1.1",
  "description": "TypeScript monorepo for Object VCS.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/core packages/firebase packages/http packages/react packages/vanilla packages/vue examples/goblin-tavern",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:example": "npm --workspace @bjalon/object-vcs-example-goblin-tavern run dev",
    "deploy:firebase:rules": "cd examples/goblin-tavern && npm run firebase:rules:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
