{
  "name": "@bjalon/object-vcs-example-goblin-tavern",
  "version": "0.1.0",
  "private": true,
  "description": "Goblin Tavern VCS example scaffold.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"vite.config.ts\"",
    "firebase:rules:deploy": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; test -n \"$VITE_FIREBASE_PROJECT_ID\" || { echo \"Missing VITE_FIREBASE_PROJECT_ID in examples/goblin-tavern/.env.local or environment\"; exit 1; }; firebase deploy --only firestore:rules --project \"$VITE_FIREBASE_PROJECT_ID\"'"
  },
  "dependencies": {
    "@bjalon/object-vcs-core": "file:../../packages/core",
    "@bjalon/object-vcs-firebase": "file:../../packages/firebase",
    "@bjalon/object-vcs-react": "file:../../packages/react",
    "firebase": "^11.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^14.22.0",
    "vite": "^5.4.21"
  }
}
