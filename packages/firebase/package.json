{
  "name": "@bjalon/object-vcs-firebase",
  "version": "0.1.0",
  "description": "Firestore persistence adapter for Object VCS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "firestore.rules",
    "FIRESTORE_RULES.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@bjalon/object-vcs-core": "file:../core"
  },
  "peerDependencies": {
    "firebase": ">=10"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  }
}
