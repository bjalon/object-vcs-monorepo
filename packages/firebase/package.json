{
  "name": "@bjalon/object-vcs-firebase",
  "version": "0.1.0",
  "description": "Firestore persistence adapter for Object VCS.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "peerDependencies": {
    "firebase": ">=10"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  }
}
