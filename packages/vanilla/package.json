{
  "name": "@bjalon/object-vcs-vanilla",
  "version": "0.1.1",
  "description": "DOM bindings for Object VCS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjalon/object-vcs-monorepo.git",
    "directory": "packages/vanilla"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@bjalon/object-vcs-core": "^0.1.1"
  }
}
