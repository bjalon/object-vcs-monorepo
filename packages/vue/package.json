{
  "name": "@bjalon/object-vcs-vue",
  "version": "0.1.1",
  "description": "Vue bindings for Object VCS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjalon/object-vcs-monorepo.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./RevisionTimeline.vue": {
      "default": "./src/RevisionTimeline.vue"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo",
    "src/RevisionTimeline.vue"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@bjalon/object-vcs-core": "^0.1.1"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": ">=3"
  }
}
